# DEVELOPMENT-ONLY, non-secret renderer config. Vite loads this only in
# development mode (`vite` dev server); it is NOT loaded by `vite build`
# (production), so production/release keeps the values in `.env`
# (benevolent-minnow-586). These are public service locations; no secrets.
#
# Standard Stella v2 development is cloud-canonical: ordinary conversations use
# the Durable Object journal via the development cloud backend. The desktop's
# Convex issuer here MUST match the staging cloud-builder's STELLA_CONVEX_SITE_URL
# (flexible-panther-999), or resolveChatStorageMode throws (no silent local
# fallback).

VITE_STELLA_CLOUD_CONVERSATIONS=1
VITE_CONVEX_URL=https://flexible-panther-999.convex.cloud
VITE_CONVEX_SITE_URL=https://flexible-panther-999.convex.site
VITE_STELLA_CLOUD_JOURNAL_ISSUER=https://flexible-panther-999.convex.site
