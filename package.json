{
  "name": "stella-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "packages/desktop/dist-electron/electron/main.js",
  "scripts": {
    "dev": "cd packages/desktop-ui && vite",
    "preview": "cd packages/desktop-ui && vite preview",
    "build": "bun run routes:generate && node node_modules/typescript-7/bin/tsc --build packages/desktop-ui && cd packages/desktop-ui && ../../node_modules/.bin/vite build && node ../desktop/scripts/check-renderer-bundle-budget.mjs",
    "format": "bunx prettier@3.6.2 --write .",
    "format:check": "bunx prettier@3.6.2 --check .",
    "lint": "cd packages/desktop-ui && eslint .",
    "logs": "node packages/desktop/scripts/open-logs.mjs",
    "test": "cd packages/desktop-ui && vitest",
    "test:run": "cd packages/desktop-ui && vitest run",
    "test:electron": "cd packages/desktop-ui && vitest run --config vitest.electron.config.ts",
    "test:stella-browser": "cargo test --manifest-path packages/stella-browser/cli/Cargo.toml -- --skip test_all_documented_actions_are_handled && node --test packages/stella-browser/extension/*.test.js packages/stella-browser/extension/**/*.test.js && vitest run packages/desktop-ui/tests/runtime/kernel/browser-use/*.test.ts",
    "routes:generate": "cd packages/desktop-ui && bunx --package @tanstack/router-cli@1.166.40 tsr generate",
    "reset": "node packages/desktop/scripts/reset-dev.mjs",
    "reset:all": "node packages/desktop/scripts/reset-dev.mjs --with-permissions",
    "reset:sql": "node packages/desktop/scripts/reset-sql.mjs",
    "native:build": "cd packages/native && npm install && npm run build",
    "native:download": "node packages/desktop/scripts/download-native-helpers.mjs",
    "stella-browser:download": "node packages/desktop/scripts/download-stella-browser.mjs",
    "workspace:create-app": "node packages/desktop/scripts/create-workspace-app.mjs",
    "electron:install": "bun ./node_modules/electron/install.js",
    "deps:prewarm": "node packages/desktop/scripts/prewarm-vite-deps.mjs",
    "electron:dev": "node packages/desktop/scripts/ensure-stella-browser.mjs --allow-build-fallback && node packages/desktop/scripts/electron-dev-runner.mjs",
    "electron:typecheck": "node node_modules/typescript-7/bin/tsc -p packages/desktop/tsconfig.electron.json --pretty false --noEmit && node node_modules/typescript-7/bin/tsc -p packages/desktop/tsconfig.preload.json --pretty false --noEmit",
    "electron:typecheck:watch": "concurrently -k --kill-others-on-fail \"node node_modules/typescript-7/bin/tsc -w -p packages/desktop/tsconfig.electron.json --preserveWatchOutput --noEmit\" \"node node_modules/typescript-7/bin/tsc -w -p packages/desktop/tsconfig.preload.json --preserveWatchOutput --noEmit\"",
    "electron:build": "bun run native:build && bun run build && node node_modules/typescript-7/bin/tsc -p packages/desktop/tsconfig.electron.json && node node_modules/typescript-7/bin/tsc -p packages/desktop/tsconfig.preload.json && electron-builder",
    "electron:preview": "bun run electron:dev:low-resource",
    "electron:dev:low-resource": "node packages/desktop/scripts/electron-low-resource-build.mjs && node packages/desktop/scripts/electron-static-preview.mjs",
    "postinstall": "node packages/desktop/scripts/postinstall-dist-electron.mjs && node packages/desktop/scripts/ensure-stella-browser.mjs --allow-build-fallback --best-effort",
    "check:boundary": "node packages/runtime/scripts/check-boundary.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1055.0",
    "@convex-dev/better-auth": "^0.12.2",
    "@google/genai": "^2.6.0",
    "@legendapp/list": "3.0.0",
    "@mistralai/mistralai": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@react-three/fiber": "^9.6.1",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@sinclair/typebox": "0.34.49",
    "@smithy/node-http-handler": "^4.7.5",
    "@smithy/types": "^4.14.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.168.11",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-auth": "1.6.11",
    "cloudflared": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.41.0",
    "croner": "^10.0.1",
    "diff": "^9.0.0",
    "dugite": "3.2.2",
    "esbuild": "^0.28.0",
    "gaxios": "^7.1.4",
    "googleapis": "^172.0.0",
    "googleapis-common": "^8.0.1",
    "motion": "^12.40.0",
    "openai": "6.39.0",
    "partial-json": "^0.1.7",
    "picomatch": "^4.0.4",
    "proxy-agent": "^8.0.1",
    "qrcode": "^1.5.4",
    "rcedit": "^5.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-grab": "^0.1.44",
    "react-pdf": "^10.4.1",
    "recharts": "^3.8.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0",
    "uiohook-napi": "^1.5.5",
    "unified": "^11.0.5",
    "undici": "^8.3.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.1",
    "@types/picomatch": "^4.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "bun-types": "1.3.14",
    "concurrently": "^10.0.0",
    "electron": "42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "29.1.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.60.0",
    "vite": "8.1.0",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "axios": "^1.13.5",
    "cross-spawn": "^7.0.6",
    "qs": "^6.15.0",
    "tar": "^7.5.10",
    "vite": "8.1.0"
  },
  "optionalDependencies": {
    "mac-screen-capture-permissions": "^2.1.0"
  },
  "build": {
    "appId": "com.stella.app",
    "productName": "Stella",
    "protocols": {
      "name": "Stella Auth",
      "schemes": [
        "Stella"
      ]
    },
    "directories": {
      "output": "packages/desktop/release",
      "buildResources": "packages/desktop/build"
    },
    "files": [
      "packages/desktop-ui/dist/**/*",
      "packages/desktop/dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "packages/desktop/resources/audio",
        "to": "audio",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packages/native/out",
        "to": "native/out",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packages/home-seed",
        "to": "home-seed",
        "filter": [
          "DREAM.md",
          "skills/**",
          "outputs/README.md"
        ]
      },
      {
        "from": "packages/runtime/extensions",
        "to": "runtime/extensions",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packages/stella-browser",
        "to": "stella-browser",
        "filter": [
          "package.json",
          "bin/stella-browser.js",
          "out/**",
          "extension/**"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "packages/desktop/build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "packages/desktop/build/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Stella uses your microphone for voice conversations."
      }
    },
    "linux": {
      "target": "AppImage",
      "icon": "packages/desktop/build/icon.png"
    }
  },
  "trustedDependencies": [
    "better-sqlite3",
    "cloudflared",
    "dugite",
    "electron",
    "electron-winstaller",
    "esbuild",
    "mac-screen-capture-permissions",
    "msgpackr-extract",
    "protobufjs",
    "sharp",
    "sqlite3",
    "uiohook-napi"
  ]
}
