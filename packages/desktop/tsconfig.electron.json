{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist-electron",
    "rootDir": "../..",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "bun-types"]
  },
  "include": [
    "electron/**/*"
  ],
  "exclude": ["electron/preload.ts", "electron/store-web-preload.ts", "**/*.test.ts"],
}
