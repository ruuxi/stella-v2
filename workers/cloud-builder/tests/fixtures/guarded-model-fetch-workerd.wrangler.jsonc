{
  "name": "stella-guarded-model-fetch-workerd",
  "main": "./guarded-model-fetch-workerd-worker.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "services": [
    {
      "binding": "GATEWAY",
      "service": "stella-guarded-model-fetch-workerd",
      "entrypoint": "Gateway",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "EXECUTORS", "class_name": "Executor" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Executor"] }],
}
