{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "outDir": "dist-electron",
    "rootDir": "../..",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // The runtime modules main imports reach `@stella/agent`, which imports
    // its modules by their .ts paths. Typechecks run with --noEmit.
    "allowImportingTsExtensions": true,
    "types": ["node", "bun-types"]
  },
  "include": [
    "electron/**/*"
  ],
  "exclude": ["electron/preload.ts", "**/*.test.ts"],
}
