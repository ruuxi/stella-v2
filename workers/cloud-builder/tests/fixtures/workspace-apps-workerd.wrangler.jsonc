{
  "name": "workspace-apps-test",
  "main": "workspace-apps-workerd.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [{ "name": "WORLDS", "class_name": "WorldStore" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorldStore"] }],
  "r2_buckets": [{ "binding": "WORLDS_BUCKET", "bucket_name": "test-worlds" }],
}
