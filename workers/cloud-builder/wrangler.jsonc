{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stella-v2-cloud-builder-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
  "vars": {
    "TELEMETRY_ENVIRONMENT": "development",
    "SANDBOX_TRANSPORT": "rpc",
    "TURN_TIMEOUT_MS": "900000",
    "SANDBOX_IDLE_TIMEOUT_MS": "600000",
    "APPS_HOST_BASE_URL": "https://stella-v2-apps-host-dev.lolruuxi.workers.dev",
    "TRUSTED_APPS_HOST_BASE_URL": "https://stella-v2-apps-auth-dev.lolruuxi.workers.dev",
    // Pinned issuer for the conversation socket's JWT verification, and the
    // fallback Convex origin for index flushes that happen outside a turn.
    // Never the JWKS env var: that is the PRIVATE key set and stays in Convex.
    "STELLA_CONVEX_SITE_URL": "https://outgoing-bulldog-865.convex.site",
    "STELLA_CONVEX_CLOUD_URL": "https://outgoing-bulldog-865.convex.cloud",
    // Strictly a dev-target proof seam. Production configs must omit both
    // values; the Worker and DO independently deny the route without them.
    "ENABLE_DEV_ACCEPTANCE_PROBES": "1",
    "STELLA_DEPLOYMENT_IDENTITY": "dev:outgoing-bulldog-865",
    // Public origin of the model gateway. Durable Objects reach it through the
    // MODEL_GATEWAY service binding (the hostname only has to parse there);
    // sandboxes use this origin directly with their turn capability.
    "MODEL_GATEWAY_URL": "https://stella-v2-model-gateway-dev.lolruuxi.workers.dev",
    // Key id under which the gateway's JWKS holds this Worker's public key.
    "CAPABILITY_SIGNING_KID": "builder-1",
    // This Worker's own public origin. Durable Objects need it to hand a
    // spawned agent's sandbox the turn-broker endpoint; a DO has no request
    // origin to derive it from.
    "CLOUD_BUILDER_PUBLIC_URL": "https://stella-v2-cloud-builder-dev.lolruuxi.workers.dev",
  },
  "secrets": {
    // CAPABILITY_SIGNING_KEY is the PKCS8 PEM of the ES256 private key that
    // signs turn capabilities; it never leaves this Worker.
    "required": [
      "BUILDER_SERVICE_SECRET",
      "META_MODEL_API_KEY",
      "CAPABILITY_SIGNING_KEY",
    ],
  },
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "services": [
    {
      "binding": "TELEMETRY",
      "service": "stella-v2-telemetry-dev",
      "entrypoint": "TelemetryService",
    },
    {
      // Browser Run, reusable website state, and Live View capabilities stay
      // behind a private Worker boundary. Builder receives only this fetcher.
      "binding": "BROWSER_GATEWAY",
      "service": "stella-v2-browser-gateway-dev",
    },
    {
      // Model gateway. Durable Objects send model traffic through this
      // binding with a turn capability as the bearer; sandboxes reach the
      // same Worker at MODEL_GATEWAY_URL.
      "binding": "MODEL_GATEWAY",
      "service": "stella-v2-model-gateway-dev",
    },
  ],
  "r2_buckets": [
    {
      "binding": "APP_BUILDS",
      "bucket_name": "stella-v2-app-builds-dev",
    },
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "stella-v2-app-builds-dev",
    },
    {
      "binding": "AGENT_HOME",
      "bucket_name": "stella-v2-agent-home-dev",
    },
    {
      // Rolled-over conversation segments and oversize-row spills.
      // Deliberately NOT AGENT_HOME: different retention, and a prefix delete
      // during account deletion must not be able to reach memory documents.
      "binding": "CONVERSATION_ARCHIVE",
      "bucket_name": "stella-v2-conversation-archive-dev",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "APP_ROUTES",
      "id": "dc5c7bac2bd04ec7bbd6a89f18a04ee7",
    },
    {
      // Create one namespace per environment, then replace this id. Keys are
      // decimal ASN numbers and values are NetworkClass strings.
      "binding": "ASN_POLICY",
      "id": "a255c73f45c94af094c46f604aaa50e8",
    },
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-4",
      "max_instances": 2,
      // TURN_TIMEOUT_MS plus one minute for exact Stop/teardown settlement.
      "rollout_active_grace_period": 960,
    },
    {
      // Every turn mints its own sandbox id and a follow-up dispatched from
      // the completion wake attaches while the finished attempt is still
      // tearing down, so two live containers per thread is normal for a
      // moment. A cap of one starved the very next cloud agent turn
      // (observed 2026-09-03: "Maximum number of running container instances
      // exceeded"), and a teardown skipped under a successor turn leaked
      // containers on keep-alive until it was fixed; six matches production
      // and leaves room for the leak-fix rollout to retire stragglers.
      "class_name": "SandboxSmall",
      "image": "./Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 6,
      "rollout_active_grace_period": 960,
    },
    {
      "class_name": "AppBuildSandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-4",
      "max_instances": 1,
      "rollout_active_grace_period": 960,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "Sandbox",
        "class_name": "Sandbox",
      },
      {
        "name": "SANDBOX_SMALL",
        "class_name": "SandboxSmall",
      },
      {
        "name": "APP_BUILD_SANDBOX",
        "class_name": "AppBuildSandbox",
      },
      {
        "name": "BUILD_SESSIONS",
        "class_name": "BuildSession",
      },
      {
        "name": "ORCHESTRATOR_SESSIONS",
        "class_name": "OrchestratorSession",
      },
      {
        "name": "OWNER_TRANSFER_COORDINATORS",
        "class_name": "OwnerTransferCoordinator",
      },
      {
        // One object per owner: plan snapshot and running-turn replay registry.
        "name": "OWNER_GATES",
        "class_name": "OwnerGate",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox", "BuildSession"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["OrchestratorSession"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["SandboxSmall"],
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["OwnerTransferCoordinator"],
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["AppBuildSandbox"],
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["DevicePresence"],
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["OwnerGate"],
    },
    {
      // Device presence moved into the owner gate: one object per owner
      // holding presence, offers, and claims together.
      "tag": "v8",
      "deleted_classes": ["DevicePresence"],
    },
  ],
  "queues": {
    "producers": [
      {
        // Durable Objects append control-plane projections here; the
        // consumer below batches them into Convex `POST /api/cloud/outbox`.
        "binding": "TURN_OUTBOX",
        "queue": "stella-v2-turn-outbox-dev",
      },
    ],
    "consumers": [
      {
        "queue": "stella-v2-turn-outbox-dev",
        "max_batch_size": 50,
        "max_batch_timeout": 2,
        "max_retries": 10,
        "dead_letter_queue": "stella-v2-turn-outbox-dlq-dev",
      },
    ],
  },
  "env": {
    "bn118": {
      "name": "stella-v2-cloud-builder-basic-nightingale-118",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "TELEMETRY_ENVIRONMENT": "development",
        "SANDBOX_TRANSPORT": "rpc",
        "TURN_TIMEOUT_MS": "900000",
        "SANDBOX_IDLE_TIMEOUT_MS": "600000",
        "APPS_HOST_BASE_URL": "https://stella-v2-apps-host-basic-nightingale-118.lolruuxi.workers.dev",
        "TRUSTED_APPS_HOST_BASE_URL": "https://stella-v2-apps-auth-basic-nightingale-118.lolruuxi.workers.dev",
        "STELLA_CONVEX_SITE_URL": "https://basic-nightingale-118.convex.site",
        "STELLA_CONVEX_CLOUD_URL": "https://basic-nightingale-118.convex.cloud",
        "ENABLE_DEV_ACCEPTANCE_PROBES": "1",
        "STELLA_DEPLOYMENT_IDENTITY": "preview:basic-nightingale-118",
        "MODEL_GATEWAY_URL": "https://stella-v2-model-gateway-dev.lolruuxi.workers.dev",
        "CAPABILITY_SIGNING_KID": "builder-bn118-1",
        "CLOUD_BUILDER_PUBLIC_URL": "https://stella-v2-cloud-builder-basic-nightingale-118.lolruuxi.workers.dev",
      },
      "secrets": {
        "required": [
          "BUILDER_SERVICE_SECRET",
          "META_MODEL_API_KEY",
          "CAPABILITY_SIGNING_KEY",
        ],
      },
      "worker_loaders": [
        {
          "binding": "LOADER",
        },
      ],
      "services": [
        {
          "binding": "TELEMETRY",
          "service": "stella-v2-telemetry-dev",
          "entrypoint": "TelemetryService",
        },
        {
          "binding": "BROWSER_GATEWAY",
          "service": "stella-v2-browser-gateway-basic-nightingale-118",
        },
        {
          "binding": "MODEL_GATEWAY",
          "service": "stella-v2-model-gateway-dev",
        },
      ],
      "r2_buckets": [
        {
          "binding": "APP_BUILDS",
          "bucket_name": "stella-v2-app-builds-basic-nightingale-118",
        },
        {
          "binding": "BACKUP_BUCKET",
          "bucket_name": "stella-v2-app-builds-basic-nightingale-118",
        },
        {
          "binding": "AGENT_HOME",
          "bucket_name": "stella-v2-agent-home-basic-nightingale-118",
        },
        {
          "binding": "CONVERSATION_ARCHIVE",
          "bucket_name": "stella-v2-conversation-archive-basic-nightingale-118",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "APP_ROUTES",
          "id": "7a0ed79419de4637aba5b8c3ff248c0e",
        },
        {
          "binding": "ASN_POLICY",
          "id": "18bca150be764b999d069d84841d30d8",
        },
      ],
      "containers": [
        {
          "class_name": "Sandbox",
          "image": "./Dockerfile",
          "instance_type": "standard-4",
          "max_instances": 1,
          "rollout_active_grace_period": 960,
        },
        {
          "class_name": "SandboxSmall",
          "image": "./Dockerfile",
          "instance_type": "standard-2",
          "max_instances": 6,
          "rollout_active_grace_period": 960,
        },
        {
          "class_name": "AppBuildSandbox",
          "image": "./Dockerfile",
          "instance_type": "standard-4",
          "max_instances": 1,
          "rollout_active_grace_period": 960,
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "Sandbox",
            "class_name": "Sandbox",
          },
          {
            "name": "SANDBOX_SMALL",
            "class_name": "SandboxSmall",
          },
          {
            "name": "APP_BUILD_SANDBOX",
            "class_name": "AppBuildSandbox",
          },
          {
            "name": "BUILD_SESSIONS",
            "class_name": "BuildSession",
          },
          {
            "name": "ORCHESTRATOR_SESSIONS",
            "class_name": "OrchestratorSession",
          },
          {
            "name": "OWNER_TRANSFER_COORDINATORS",
            "class_name": "OwnerTransferCoordinator",
          },
          {
            "name": "OWNER_GATES",
            "class_name": "OwnerGate",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["Sandbox", "BuildSession"],
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["OrchestratorSession"],
        },
        {
          "tag": "v3",
          "new_sqlite_classes": ["SandboxSmall"],
        },
        {
          "tag": "v4",
          "new_sqlite_classes": ["OwnerTransferCoordinator"],
        },
        {
          "tag": "v5",
          "new_sqlite_classes": ["AppBuildSandbox"],
        },
        {
          "tag": "v6",
          "new_sqlite_classes": ["DevicePresence"],
        },
        {
          "tag": "v7",
          "new_sqlite_classes": ["OwnerGate"],
        },
        {
          "tag": "v8",
          "deleted_classes": ["DevicePresence"],
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "TURN_OUTBOX",
            "queue": "stella-v2-turn-outbox-basic-nightingale-118",
          },
        ],
        "consumers": [
          {
            "queue": "stella-v2-turn-outbox-basic-nightingale-118",
            "max_batch_size": 50,
            "max_batch_timeout": 2,
            "max_retries": 10,
            "dead_letter_queue": "stella-v2-turn-outbox-dlq-basic-nightingale-118",
          },
        ],
      },
    },
    "production": {
      "name": "stella-v2-cloud-builder-prod",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "TELEMETRY_ENVIRONMENT": "production",
        "SANDBOX_TRANSPORT": "rpc",
        "TURN_TIMEOUT_MS": "900000",
        "SANDBOX_IDLE_TIMEOUT_MS": "600000",
        "APPS_HOST_BASE_URL": "https://stella-v2-apps-host-prod.lolruuxi.workers.dev",
        "TRUSTED_APPS_HOST_BASE_URL": "https://stella-v2-apps-auth-prod.lolruuxi.workers.dev",
        "STELLA_CONVEX_SITE_URL": "https://intent-jackal-330.convex.site",
        "STELLA_CONVEX_CLOUD_URL": "https://intent-jackal-330.convex.cloud",
        "STELLA_DEPLOYMENT_IDENTITY": "prod:intent-jackal-330",
        "MODEL_GATEWAY_URL": "https://stella-v2-model-gateway.lolruuxi.workers.dev",
        "CAPABILITY_SIGNING_KID": "builder-prod-1",
        "CLOUD_BUILDER_PUBLIC_URL": "https://stella-v2-cloud-builder-prod.lolruuxi.workers.dev",
      },
      "secrets": {
        "required": [
          "BUILDER_SERVICE_SECRET",
          "META_MODEL_API_KEY",
          "CAPABILITY_SIGNING_KEY",
        ],
      },
      "worker_loaders": [
        {
          "binding": "LOADER",
        },
      ],
      "services": [
        {
          "binding": "TELEMETRY",
          "service": "stella-v2-telemetry",
          "entrypoint": "TelemetryService",
        },
        {
          "binding": "BROWSER_GATEWAY",
          "service": "stella-v2-browser-gateway-prod",
        },
        {
          "binding": "MODEL_GATEWAY",
          "service": "stella-v2-model-gateway",
        },
      ],
      "r2_buckets": [
        {
          "binding": "APP_BUILDS",
          "bucket_name": "stella-v2-app-builds-prod",
        },
        {
          "binding": "BACKUP_BUCKET",
          "bucket_name": "stella-v2-app-builds-prod",
        },
        {
          "binding": "AGENT_HOME",
          "bucket_name": "stella-v2-agent-home-prod",
        },
        {
          "binding": "CONVERSATION_ARCHIVE",
          "bucket_name": "stella-v2-conversation-archive-prod",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "APP_ROUTES",
          "id": "d3548a90824440bea312fc4600687077",
        },
        {
          "binding": "ASN_POLICY",
          "id": "ead91aec5ef6410d92a530974f220797",
        },
      ],
      "containers": [
        {
          "class_name": "Sandbox",
          "image": "./Dockerfile",
          "instance_type": "standard-4",
          "max_instances": 1,
          "rollout_active_grace_period": 960,
        },
        {
          // Physical capacity guard only. The model-gateway token budget is
          // the only product limit.
          "class_name": "SandboxSmall",
          "image": "./Dockerfile",
          "instance_type": "standard-2",
          "max_instances": 24,
          "rollout_active_grace_period": 960,
        },
        {
          "class_name": "AppBuildSandbox",
          "image": "./Dockerfile",
          "instance_type": "standard-4",
          "max_instances": 1,
          "rollout_active_grace_period": 960,
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "Sandbox",
            "class_name": "Sandbox",
          },
          {
            "name": "SANDBOX_SMALL",
            "class_name": "SandboxSmall",
          },
          {
            "name": "APP_BUILD_SANDBOX",
            "class_name": "AppBuildSandbox",
          },
          {
            "name": "BUILD_SESSIONS",
            "class_name": "BuildSession",
          },
          {
            "name": "ORCHESTRATOR_SESSIONS",
            "class_name": "OrchestratorSession",
          },
          {
            "name": "OWNER_TRANSFER_COORDINATORS",
            "class_name": "OwnerTransferCoordinator",
          },
          {
            "name": "OWNER_GATES",
            "class_name": "OwnerGate",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["Sandbox", "BuildSession"],
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["OrchestratorSession"],
        },
        {
          "tag": "v3",
          "new_sqlite_classes": ["SandboxSmall"],
        },
        {
          "tag": "v4",
          "new_sqlite_classes": ["OwnerTransferCoordinator"],
        },
        {
          "tag": "v5",
          "new_sqlite_classes": ["AppBuildSandbox"],
        },
        {
          "tag": "v6",
          "new_sqlite_classes": ["DevicePresence"],
        },
        {
          "tag": "v7",
          "new_sqlite_classes": ["OwnerGate"],
        },
        {
          "tag": "v8",
          "deleted_classes": ["DevicePresence"],
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "TURN_OUTBOX",
            "queue": "stella-v2-turn-outbox",
          },
        ],
        "consumers": [
          {
            "queue": "stella-v2-turn-outbox",
            "max_batch_size": 50,
            "max_batch_timeout": 2,
            "max_retries": 10,
            "dead_letter_queue": "stella-v2-turn-outbox-dlq",
          },
        ],
      },
    },
  },
}
