{
  "name": "stella-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "bun run build:chat",
    "dev": "next dev",
    "prebuild": "bun run build:chat",
    "build": "next build --webpack",
    "build:chat": "bun ../desktop/scripts/build-web-renderer.ts",
    "build-google-ads-import": "bun scripts/build-google-ads-import.mjs",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "deploy:dev": "bash scripts/deploy-stella.sh dev",
    "deploy:production": "bash scripts/deploy-stella.sh production",
    "lint": "eslint",
    "test": "bun test tests",
    "typecheck": "node ../../node_modules/typescript-7/bin/tsc --noEmit",
    "optimize-canvas-demos": "bun scripts/optimize-canvas-screenshots.mjs"
  },
  "dependencies": {
    "@stella/contracts": "workspace:*",
    "better-auth": "1.7.7",
    "lenis": "^1.3.26",
    "lightningcss": "1.33.0",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "ogl": "^1.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "streamdown": "2.7.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "lightningcss": "1.32.0"
  }
}
