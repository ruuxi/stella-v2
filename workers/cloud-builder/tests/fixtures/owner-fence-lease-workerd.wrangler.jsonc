{
  "name": "stella-owner-fence-lease-workerd-acceptance",
  "main": "./owner-fence-lease-workerd-worker.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BUILDER_SERVICE_SECRET": "fixture-secret",
    "TURN_TIMEOUT_MS": "900000",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BUILD_SESSIONS",
        "class_name": "LeaseTestBuildSession",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LeaseTestBuildSession"],
    },
  ],
}
