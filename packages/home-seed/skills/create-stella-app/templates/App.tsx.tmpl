        <p className="app-eyebrow">Stella app</p>
        <h1>{ {{NAME_JSON}} }</h1>
        <p>Replace this starting point with the app you want to build.</p>
      </header>

      <section className="app-content">
        <button type="button" onClick={() => setCount((value) => value + 1)}>
          Clicked {count} times
        </button>
      </section>
    </main>
  );
}
