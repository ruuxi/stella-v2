{
  "name": "stella-orchestrator-wrapper-workerd-acceptance",
  "main": "./orchestrator-wrapper-workerd-worker.ts",
  // The built-in cloud app skill imports its SKILL.md as text, as the
  // production build does with esbuild's ".md" text loader.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "ORCHESTRATOR_SESSIONS",
        "class_name": "OrchestratorSession",
      },
      {
        "name": "OWNER_GATES",
        "class_name": "OwnerReaderRegistry",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OrchestratorSession", "OwnerReaderRegistry"],
    },
  ],
}
