# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Real native store captures (release artifacts, never source)
/public/captures/

# Unaltered output images used alongside native captures
/public/supporting/

# Third-party hardware assets prohibit standalone redistribution; keep SOURCES.md
/public/devices/*.png

# Actual Chrome Web Store captures; retain source metadata only
/public/chrome-store/*.png
