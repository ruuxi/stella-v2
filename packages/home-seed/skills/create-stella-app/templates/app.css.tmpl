:root {
  color-scheme: light dark;
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
    sans-serif;
  color: #171717;
  background: #f5f5f3;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  width: 100%;
  min-width: 0;
  height: 100%;
  margin: 0;
}

button,
input,
textarea,
select {
  font: inherit;
}

.app-shell {
  container-type: inline-size;
  width: 100%;
  min-height: 100%;
  padding: clamp(1rem, 5cqi, 3rem);
}

.app-hero {
  max-width: 64rem;
}

.app-eyebrow {
  margin: 0 0 0.75rem;
  color: #6b6b67;
  font-size: 0.75rem;
  font-weight: 650;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.app-hero h1 {
  margin: 0;
  font-size: clamp(2rem, 9cqi, 5rem);
  font-weight: 500;
  letter-spacing: -0.05em;
  line-height: 0.95;
}

.app-hero > p:last-child {
  max-width: 52ch;
  margin: 1rem 0 0;
  color: #5f5f5b;
  line-height: 1.6;
}

.app-content {
  margin-top: clamp(2rem, 7cqi, 5rem);
}

.app-content button {
  min-height: 2.75rem;
  padding: 0.65rem 1rem;
  border: 1px solid #d2d2cd;
  border-radius: 0.75rem;
  color: inherit;
  background: #fff;
  cursor: pointer;
}

.app-content button:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 3px;
}

@media (prefers-color-scheme: dark) {
  :root {
    color: #f1f1ef;
    background: #171716;
  }

  .app-eyebrow,
  .app-hero > p:last-child {
    color: #adada7;
  }

  .app-content button {
    border-color: #444440;
    background: #242422;
  }
}
