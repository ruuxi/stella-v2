{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stella-v2-cloud-builder-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "SANDBOX_TRANSPORT": "rpc",
    "TURN_TIMEOUT_MS": "900000",
    "SANDBOX_IDLE_TIMEOUT_MS": "600000",
    "APPS_HOST_BASE_URL": "https://stella-v2-apps-host-dev.lolruuxi.workers.dev",
    // Pinned issuer for the conversation socket's JWT verification, and the
    // fallback Convex origin for index flushes that happen outside a turn.
    // Never the JWKS env var: that is the PRIVATE key set and stays in Convex.
    "STELLA_CONVEX_SITE_URL": "https://impartial-crab-34.convex.site",
    "STELLA_CONVEX_CLOUD_URL": "https://impartial-crab-34.convex.cloud",
    // Strictly a dev-target proof seam. Production configs must omit both
    // values; the Worker and DO independently deny the route without them.
    "ENABLE_DEV_ACCEPTANCE_PROBES": "1",
    "STELLA_DEPLOYMENT_IDENTITY": "dev:impartial-crab-34"
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "r2_buckets": [
    {
      "binding": "APP_BUILDS",
      "bucket_name": "stella-v2-app-builds-dev"
    },
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "stella-v2-app-builds-dev"
    },
    {
      "binding": "AGENT_HOME",
      "bucket_name": "stella-v2-agent-home-dev"
    },
    {
      // Rolled-over conversation segments and oversize-row spills.
      // Deliberately NOT AGENT_HOME: different retention, and a prefix delete
      // during account deletion must not be able to reach memory documents.
      "binding": "CONVERSATION_ARCHIVE",
      "bucket_name": "stella-v2-conversation-archive-dev"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "APP_ROUTES",
      "id": "dc5c7bac2bd04ec7bbd6a89f18a04ee7"
    }
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-4",
      "max_instances": 1
    },
    {
      "class_name": "SandboxSmall",
      "image": "./Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "Sandbox",
        "class_name": "Sandbox"
      },
      {
        "name": "SANDBOX_SMALL",
        "class_name": "SandboxSmall"
      },
      {
        "name": "BUILD_SESSIONS",
        "class_name": "BuildSession"
      },
      {
        "name": "ORCHESTRATOR_SESSIONS",
        "class_name": "OrchestratorSession"
      },
      {
        "name": "OWNER_TRANSFER_COORDINATORS",
        "class_name": "OwnerTransferCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox", "BuildSession"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["OrchestratorSession"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["SandboxSmall"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["OwnerTransferCoordinator"]
    }
  ],
  "env": {
    "bn118": {
      "name": "stella-v2-cloud-builder-basic-nightingale-118",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "SANDBOX_TRANSPORT": "rpc",
        "TURN_TIMEOUT_MS": "900000",
        "SANDBOX_IDLE_TIMEOUT_MS": "600000",
        "APPS_HOST_BASE_URL": "https://stella-v2-apps-host-basic-nightingale-118.lolruuxi.workers.dev",
        "STELLA_CONVEX_SITE_URL": "https://basic-nightingale-118.convex.site",
        "STELLA_CONVEX_CLOUD_URL": "https://basic-nightingale-118.convex.cloud",
        "ENABLE_DEV_ACCEPTANCE_PROBES": "1",
        "STELLA_DEPLOYMENT_IDENTITY": "preview:basic-nightingale-118"
      },
      "secrets": {
        "required": ["BUILDER_SERVICE_SECRET"]
      },
      "worker_loaders": [
        {
          "binding": "LOADER"
        }
      ],
      "r2_buckets": [
        {
          "binding": "APP_BUILDS",
          "bucket_name": "stella-v2-app-builds-basic-nightingale-118"
        },
        {
          "binding": "BACKUP_BUCKET",
          "bucket_name": "stella-v2-app-builds-basic-nightingale-118"
        },
        {
          "binding": "AGENT_HOME",
          "bucket_name": "stella-v2-agent-home-basic-nightingale-118"
        },
        {
          "binding": "CONVERSATION_ARCHIVE",
          "bucket_name": "stella-v2-conversation-archive-basic-nightingale-118"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "APP_ROUTES",
          "id": "7a0ed79419de4637aba5b8c3ff248c0e"
        }
      ],
      "containers": [
        {
          "class_name": "Sandbox",
          "image": "./Dockerfile",
          "instance_type": "standard-4",
          "max_instances": 1
        },
        {
          "class_name": "SandboxSmall",
          "image": "./Dockerfile",
          "instance_type": "standard-2",
          "max_instances": 1
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "Sandbox",
            "class_name": "Sandbox"
          },
          {
            "name": "SANDBOX_SMALL",
            "class_name": "SandboxSmall"
          },
          {
            "name": "BUILD_SESSIONS",
            "class_name": "BuildSession"
          },
          {
            "name": "ORCHESTRATOR_SESSIONS",
            "class_name": "OrchestratorSession"
          },
          {
            "name": "OWNER_TRANSFER_COORDINATORS",
            "class_name": "OwnerTransferCoordinator"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["Sandbox", "BuildSession"]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["OrchestratorSession"]
        },
        {
          "tag": "v3",
          "new_sqlite_classes": ["SandboxSmall"]
        },
        {
          "tag": "v4",
          "new_sqlite_classes": ["OwnerTransferCoordinator"]
        }
      ]
    }
  }
}
