{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The @stelladotsh X bot. X posts mention events to /webhook; the worker
  // answers each in waitUntil with a model-written reply plus a rendered card,
  // and stella.sh/x/<handle> reads /page/<handle>. Satori and resvg live here
  // so cloud-builder never carries them.
  "name": "stella-v2-x-bot-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "preview_urls": false,
  "rules": [{ "type": "Data", "globs": ["**/*.woff"], "fallthrough": false }],
  // satori's text shaping; see src/harfbuzz.js.
  "alias": { "harfbuzzjs": "./src/harfbuzz.js" },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  // Retries runs whose waitUntil died before posting.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "X_BOT_USERNAME": "stelladotsh",
    "X_BOT_USER_ID": "2060465384223027200",
    // Comma-separated X usernames of our own promoter accounts. When one of
    // them summons the bot, the page is addressed to the original poster.
    "X_BOT_PROMOTER_USERNAMES": "",
    "X_BOT_MODEL": "gpt-5.4-mini",
    // "1" renders and stores the card and the run and logs the reply, without
    // uploading media or posting to X.
    "X_BOT_DRY_RUN": ""
  },
  "secrets": {
    "required": [
      "X_BOT_API_KEY",
      "X_BOT_API_SECRET",
      "X_BOT_ACCESS_TOKEN",
      "X_BOT_ACCESS_TOKEN_SECRET",
      "OPENAI_API_KEY"
    ]
  },
  // cloud-builder owns this database's migrations; x_bot_runs is created in
  // workers/cloud-builder/migrations/0002_catalog.sql.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stella-v2-dev",
      "database_id": "a2cd9816-891c-4642-9f07-094251947a84"
    }
  ],
  // Rendered cards live under x-bot/ and are served by GET /card/<mention>.png.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "stella-v2-media-dev"
    }
  ]
}
