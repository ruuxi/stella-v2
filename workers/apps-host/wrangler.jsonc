{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stella-v2-apps-host-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": false,
    },
  },
  "vars": {},
  "services": [
    {
      "binding": "CLOUD_APPS",
      "service": "stella-v2-cloud-builder-dev",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "APP_FETCH_GATE",
        "class_name": "AppFetchGate",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AppFetchGate"],
    },
  ],
  "env": {
    "bn118": {
      "name": "stella-v2-apps-host-basic-nightingale-118",
      "workers_dev": true,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "invocation_logs": false,
          "head_sampling_rate": 1,
        },
        "traces": {
          "enabled": false,
        },
      },
      "vars": {},
      "services": [
        {
          "binding": "CLOUD_APPS",
          "service": "stella-v2-cloud-builder-basic-nightingale-118",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "APP_FETCH_GATE",
            "class_name": "AppFetchGate",
          },
        ],
      },
    },
    "production": {
      "name": "stella-v2-apps-host-prod",
      "workers_dev": true,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "invocation_logs": false,
          "head_sampling_rate": 1,
        },
        "traces": {
          "enabled": false,
        },
      },
      "vars": {},
      "services": [
        {
          "binding": "CLOUD_APPS",
          "service": "stella-v2-cloud-builder-prod",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "APP_FETCH_GATE",
            "class_name": "AppFetchGate",
          },
        ],
      },
    },
  },
}
