          "binding": "WORLDS_BUCKET",
          "bucket_name": "stella-v2-worlds-prod",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "APP_ROUTES",
          "id": "d3548a90824440bea312fc4600687077",
        },
        {
          "binding": "ASN_POLICY",
          "id": "ead91aec5ef6410d92a530974f220797",
        },
