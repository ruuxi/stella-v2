{
  // Runtime-scoped typecheck (`bun run runtime:typecheck`). The renderer,
  // electron, and preload projects never include this package, so this config
  // keeps type breaks (e.g. a callback missing from a completion API) visible.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "bun-types"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
