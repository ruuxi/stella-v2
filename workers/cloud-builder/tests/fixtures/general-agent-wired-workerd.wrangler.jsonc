{
  "name": "stella-general-agent-wired-workerd-acceptance",
  "main": "./general-agent-wired-workerd-worker.ts",
  // The built-in cloud app skill imports its SKILL.md as text, as the
  // production build does with esbuild's ".md" text loader.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WIRED_TURNS",
        "class_name": "WiredTurnHarness",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WiredTurnHarness"],
    },
  ],
}
