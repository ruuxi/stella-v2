{
  "name": "stella-owner-model-grants-workerd-acceptance",
  "main": "./owner-model-grants-workerd-worker.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BUILDER_SERVICE_SECRET": "fixture-secret",
    "TURN_TIMEOUT_MS": "900000",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OWNER_GATES",
        "class_name": "GrantTestOwnerGate",
      },
      {
        "name": "ORCHESTRATOR_SESSIONS",
        "class_name": "OwnerGrantProtocolReader",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GrantTestOwnerGate", "OwnerGrantProtocolReader"],
    },
  ],
}
