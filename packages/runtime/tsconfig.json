{
  // Runtime-scoped typecheck (`bun run runtime:typecheck`). The renderer,
  // electron, and preload projects never include this package, so without
  // this config the kernel/worker sources are only ever executed by vitest
  // — type breaks (e.g. a callback missing from a completion API) stay
  // invisible when test mocks stand in for the real modules.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "bun-types"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts"]
}
