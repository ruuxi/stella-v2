{
  "name": "@stella/browser-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test ./tests/config.test.ts ./tests/protocol-boundary.test.ts ./tests/profile-crypto.test.ts ./tests/profile-session-core.test.ts ./tests/safe-observation.test.ts ./tests/network-policy.test.ts ./tests/handoff-navigation-policy.test.ts ./tests/device-code-fixture-client.test.ts",
    "test:workerd": "bun test ./tests/browser-profile-session-workerd.test.ts",
    "test": "bun run test:unit && bun run test:workerd",
    "build:dry-run": "wrangler deploy --dry-run --env= --outdir .wrangler/dry-run-dev",
    "build:dry-run:bn118": "wrangler deploy --dry-run --env bn118 --outdir .wrangler/dry-run-bn118",
    "deploy:dev": "wrangler deploy --env= --strict",
    "deploy:bn118": "wrangler deploy --env bn118 --strict"
  },
  "dependencies": {
    "@cloudflare/playwright": "1.3.6",
    "@stella/device-code-fixture": "workspace:*",
    "playwright-core": "1.58.2",
    "tldts": "7.0.30"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260723.1",
    "typescript": "^6.0.3",
    "wrangler": "4.113.0"
  }
}
