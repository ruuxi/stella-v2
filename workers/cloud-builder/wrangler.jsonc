{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stella-v2-cloud-builder-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "SANDBOX_TRANSPORT": "rpc",
    "TURN_TIMEOUT_MS": "900000",
    "SANDBOX_IDLE_TIMEOUT_MS": "600000"
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-4",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "Sandbox",
        "class_name": "Sandbox"
      },
      {
        "name": "BUILD_SESSIONS",
        "class_name": "BuildSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox", "BuildSession"]
    }
  ]
}
