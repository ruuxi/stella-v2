{
  "name": "stella-owner-store-workerd-acceptance",
  "main": "./owner-store-workerd-worker.ts",
  // The built-in cloud app skill imports its SKILL.md as text, as the
  // production build does with esbuild's ".md" text loader.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BUILDER_SERVICE_SECRET": "fixture-secret",
    "TURN_TIMEOUT_MS": "900000",
  },
  "durable_objects": {
    "bindings": [{ "name": "OWNER_GATES", "class_name": "StoreTestOwnerGate" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StoreTestOwnerGate"] }],
}
