{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "bun": "1.4.0",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1"
      }
    },
    "preview": {
      "bun": "1.4.0",
      "distribution": "store",
      "autoIncrement": true,
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_STELLA_BACKEND_URL": "https://stella-v2-cloud-builder-dev.lolruuxi.workers.dev",
        "EXPO_PUBLIC_PLAY_INTEGRITY_PROJECT_NUMBER": "450329171803"
      },
      "android": {
        "distribution": "internal",
        "buildType": "apk"
      }
    },
    "production": {
      "bun": "1.4.0",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1",
        "EXPO_PUBLIC_STELLA_BACKEND_URL": "https://stella-v2-cloud-builder-prod.lolruuxi.workers.dev",
        "EXPO_PUBLIC_PLAY_INTEGRITY_PROJECT_NUMBER": "450329171803"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6761148311"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    },
    "preview": {
      "ios": {
        "ascAppId": "6761148311"
      }
    }
  }
}
