{
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,
    "noEmit": true
  },
  // Tests use the Bun runtime (bun:test, bun:sqlite) and are typechecked by
  // `bun test`, not tsc.
  "include": ["src/**/*.ts"]
}
