{
  // Non-secret configuration for cloud-enabled development against the real
  // remote staging journal worker. The bearer token is a Worker secret and is
  // read from the environment (or a local, git-ignored .dev.vars) — never here.
  "cloud": {
    "enabled": true,
    "journalWorkerUrl": "https://stella-v2-journal-realstaging.lolruuxi.workers.dev",
    "journalTokenEnvVar": "STELLA_CLOUD_JOURNAL_TOKEN",
    "convex": {
      // Isolated dev projection deployment (not the shared flexible-panther-999).
      "deployment": "opulent-labrador-370",
      "url": "https://opulent-labrador-370.convex.cloud"
    }
  },
  // The in-process journal server is a unit/integration-test helper only and is
  // never the configured cloud authority in standard development.
  "notes": "Standard cloud dev targets the remote staging Worker above; loopback servers are test-only."
}
