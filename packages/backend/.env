# Public, non-secret Convex deployment config for the shared dev backend.
# Same tier of value as the tracked packages/desktop-ui/.env: these are public
# service locations, not credentials. Auth stays in CONVEX_DEPLOY_KEY, which is
# supplied through the environment and is never committed.
#
# The Convex CLI owns .env.local and writes deploy state there; that file stays
# gitignored and still overrides these values locally when it exists.

CONVEX_DEPLOYMENT=dev:outgoing-bulldog-865
CONVEX_URL=https://outgoing-bulldog-865.convex.cloud
CONVEX_SITE_URL=https://outgoing-bulldog-865.convex.site
