{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stella-v2-apps-host-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
  "vars": {
    // This Worker has exactly one authorized control-plane target. Runtime
    // validation rejects missing, stale, or production-shaped alternatives.
    "STELLA_DEPLOYMENT_IDENTITY": "dev:outgoing-bulldog-865",
    "HOST_ROLE": "untrusted",
    "SHARES_DISABLED": "false",
    "CONVEX_SITE_URL": "https://outgoing-bulldog-865.convex.site",
    "CONVEX_CLOUD_URL": "https://outgoing-bulldog-865.convex.cloud",
    "APPS_HOST_ORIGIN": "https://stella-v2-apps-host-dev.lolruuxi.workers.dev",
    "TRUSTED_APPS_HOST_ORIGIN": "https://stella-v2-apps-auth-dev.lolruuxi.workers.dev",
    "CLOUD_BUILDER_ORIGIN": "https://stella-v2-cloud-builder-dev.lolruuxi.workers.dev",
  },
  "services": [
    {
      "binding": "APP_AUTH",
      "service": "stella-v2-apps-auth-dev",
      "entrypoint": "AppsAuthService"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "APP_FETCH_GATE", "class_name": "AppFetchGate" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AppFetchGate"] }
  ],
  "r2_buckets": [
    {
      "binding": "APP_BUILDS",
      "bucket_name": "stella-v2-app-builds-dev",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "APP_ROUTES",
      "id": "dc5c7bac2bd04ec7bbd6a89f18a04ee7",
    },
  ],
  "env": {
    "bn118": {
      "name": "stella-v2-apps-host-basic-nightingale-118",
      "workers_dev": true,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 0.05 }
      },
      "vars": {
        "STELLA_DEPLOYMENT_IDENTITY": "preview:basic-nightingale-118",
        "HOST_ROLE": "untrusted",
        "SHARES_DISABLED": "false",
        "CONVEX_SITE_URL": "https://basic-nightingale-118.convex.site",
        "CONVEX_CLOUD_URL": "https://basic-nightingale-118.convex.cloud",
        "APPS_HOST_ORIGIN": "https://stella-v2-apps-host-basic-nightingale-118.lolruuxi.workers.dev",
        "TRUSTED_APPS_HOST_ORIGIN": "https://stella-v2-apps-auth-basic-nightingale-118.lolruuxi.workers.dev",
        "CLOUD_BUILDER_ORIGIN": "https://stella-v2-cloud-builder-basic-nightingale-118.lolruuxi.workers.dev",
      },
      "services": [
        {
          "binding": "APP_AUTH",
          "service": "stella-v2-apps-auth-basic-nightingale-118",
          "entrypoint": "AppsAuthService"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "APP_FETCH_GATE", "class_name": "AppFetchGate" }
        ]
      },
      "r2_buckets": [
        {
          "binding": "APP_BUILDS",
          "bucket_name": "stella-v2-app-builds-basic-nightingale-118",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "APP_ROUTES",
          "id": "7a0ed79419de4637aba5b8c3ff248c0e",
        },
      ],
    },
  },
}
