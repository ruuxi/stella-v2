{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stella-v2-cloud-builder-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "SANDBOX_TRANSPORT": "rpc",
    "TURN_TIMEOUT_MS": "900000",
    "SANDBOX_IDLE_TIMEOUT_MS": "600000",
    "APPS_HOST_BASE_URL": "https://stella-v2-apps-host-dev.lolruuxi.workers.dev"
  },
  "r2_buckets": [
    {
      "binding": "APP_BUILDS",
      "bucket_name": "stella-v2-app-builds-dev"
    },
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "stella-v2-app-builds-dev"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "APP_ROUTES",
      "id": "dc5c7bac2bd04ec7bbd6a89f18a04ee7"
    }
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-4",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "Sandbox",
        "class_name": "Sandbox"
      },
      {
        "name": "BUILD_SESSIONS",
        "class_name": "BuildSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox", "BuildSession"]
    }
  ]
}
