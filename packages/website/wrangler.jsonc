{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stella-website-dev",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true },
  "env": {
    "production": {
      "name": "stella-website-prod",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [{ "pattern": "stella.sh", "custom_domain": true }],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none"
      },
      "images": { "binding": "IMAGES" },
      "observability": { "enabled": true }
    }
  }
}
