{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stella-v2-model-gateway-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
  "limits": {
    // Managed completions stream from the provider for minutes; assembly and
    // usage parsing are CPU-light but the wall clock is long.
    "cpu_ms": 60000,
  },
  "vars": {
    "ENVIRONMENT": "development",
    // Canonical development deployment used by source builds and test traffic.
    "STELLA_CONVEX_SITE_URL": "https://outgoing-bulldog-865.convex.site",
    // JSON `GatewayJwks` holding the PUBLIC ES256 keys of both capability
    // issuers (Convex `CAPABILITY_SIGNING_KID` and cloud-builder's). Ops
    // Keep the public keys in deployment config so future deploys cannot
    // accidentally restore the fail-closed empty placeholder.
    "CAPABILITY_JWKS": "{\"keys\":[{\"kid\":\"convex-1\",\"issuer\":\"stella-convex\",\"jwk\":{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"z3UW7w02DZv-HzQqRwzPTEYN3PIO9hIxjcj7d8DRo3E\",\"y\":\"oGXA5AT_zPGJrJxcv5UgwyV2fhC4mQEAGckZEmn15W0\",\"alg\":\"ES256\",\"use\":\"sig\"}},{\"kid\":\"builder-1\",\"issuer\":\"stella-cloud-builder\",\"jwk\":{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"_zTj5c7FMbjcMng9baQbQRXtkHak6jk4-1boqSnt59A\",\"y\":\"tR-kttYxzHOPR__VorAqBes7AkaI9uvAiyuM7h7DMEk\",\"alg\":\"ES256\",\"use\":\"sig\"}},{\"kid\":\"builder-bn118-1\",\"issuer\":\"stella-cloud-builder\",\"jwk\":{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"3B2uhLMZ0nFNovFPfyHOqiVeXac4vJO0YhR1F7U1xQc\",\"y\":\"_vW3crzH0DnvV5yjUqvxa9qH5_lygAfXR7FWiI7MLAA\",\"alg\":\"ES256\",\"use\":\"sig\"}}]}",
  },
  "secrets": {
    "required": [
      "OPENROUTER_API_KEY",
      "FIREWORKS_API_KEY",
      "DEEPSEEK_API_KEY",
      "CROF_API_KEY",
      "WAFER_API_KEY",
      "XAI_API_KEY",
      "OPENAI_API_KEY",
      "ANTHROPIC_API_KEY",
      "GOOGLE_AI_API_KEY",
      "META_MODEL_API_KEY",
      "GATEWAY_SERVICE_SECRET",
      "STELLA_RELAY_PROBE_SECRET",
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        // One object per capability `jti`: budget/request ledger plus the
        // replayable result cache for idempotent retries.
        "name": "CAPABILITY_LEDGER",
        "class_name": "CapabilityLedger",
      },
      {
        "name": "OWNER_CAPABILITY_LEDGER",
        "class_name": "OwnerCapabilityLedger",
      },
      {
        "name": "OWNER_RELAY_GATE",
        "class_name": "OwnerRelayGate",
      },
      {
        "name": "NETWORK_GATE",
        "class_name": "NetworkGate",
      },
      {
        "name": "TIER_BUDGET",
        "class_name": "TierBudget",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CapabilityLedger"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["OwnerRelayGate", "NetworkGate", "TierBudget"],
    },
    { "tag": "v3", "new_sqlite_classes": ["OwnerCapabilityLedger"] },
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG_SNAPSHOT",
      "id": "1cca6b348e5a4998baab44e3333a1f49",
    },
    {
      "binding": "OWNER_ENFORCEMENT",
      "id": "4db6e39e36a7452d819cd91244e68655",
    },
    {
      // Create one namespace per environment, then replace this id. Keys are
      // decimal ASN numbers and values are NetworkClass strings.
      "binding": "ASN_POLICY",
      "id": "a255c73f45c94af094c46f604aaa50e8",
    },
  ],
  "triggers": {
    "crons": ["*/2 * * * *"],
  },
  "queues": {
    "producers": [
      {
        "binding": "USAGE_QUEUE",
        "queue": "stella-v2-gateway-usage-dev",
      },
    ],
    "consumers": [
      {
        "queue": "stella-v2-gateway-usage-dev",
        "max_batch_size": 50,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "stella-v2-gateway-usage-dlq-dev",
      },
    ],
  },
  "ratelimits": [
    {
      "name": "ANON_IP_LIMITER",
      // Account-local integer namespace. Replace if already allocated.
      "namespace_id": "41011",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "env": {
    "production": {
      "name": "stella-v2-model-gateway",
      "workers_dev": true,
      "preview_urls": false,
      "limits": {
        "cpu_ms": 60000,
      },
      "vars": {
        "ENVIRONMENT": "production",
        // Pinned to the packaged desktop release authority.
        "STELLA_CONVEX_SITE_URL": "https://intent-jackal-330.convex.site",
        // Public production keys for the Convex and cloud-builder issuers.
        "CAPABILITY_JWKS": "{\"keys\":[{\"kid\":\"convex-prod-1\",\"issuer\":\"stella-convex\",\"jwk\":{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"LSAu5q_qmUxnER3kfeTUc61NiBoO_A8nk7srI9-EBNg\",\"y\":\"iK4eBIPxte1DlIdQLsLSVCCMapC5nBF-y6pTRSnDkvc\",\"alg\":\"ES256\",\"use\":\"sig\"}},{\"kid\":\"builder-prod-1\",\"issuer\":\"stella-cloud-builder\",\"jwk\":{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"7OPXbcbubpfZqHAZEptNA8Bu1w9Y5D0pq547cg8rYuo\",\"y\":\"tv8_giBW3W4shXI5YPuZMneKHs22dSncE41399_mEmI\",\"alg\":\"ES256\",\"use\":\"sig\"}}]}",
      },
      "secrets": {
        "required": [
          "OPENROUTER_API_KEY",
          "FIREWORKS_API_KEY",
          "DEEPSEEK_API_KEY",
          "CROF_API_KEY",
          "WAFER_API_KEY",
          "XAI_API_KEY",
          "OPENAI_API_KEY",
          "ANTHROPIC_API_KEY",
          "GOOGLE_AI_API_KEY",
          "META_MODEL_API_KEY",
          "GATEWAY_SERVICE_SECRET",
          "STELLA_RELAY_PROBE_SECRET",
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "CAPABILITY_LEDGER",
            "class_name": "CapabilityLedger",
          },
          {
            "name": "OWNER_CAPABILITY_LEDGER",
            "class_name": "OwnerCapabilityLedger",
          },
          {
            "name": "OWNER_RELAY_GATE",
            "class_name": "OwnerRelayGate",
          },
          {
            "name": "NETWORK_GATE",
            "class_name": "NetworkGate",
          },
          {
            "name": "TIER_BUDGET",
            "class_name": "TierBudget",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["CapabilityLedger"],
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["OwnerRelayGate", "NetworkGate", "TierBudget"],
        },
        { "tag": "v3", "new_sqlite_classes": ["OwnerCapabilityLedger"] },
      ],
      "kv_namespaces": [
        {
          "binding": "CONFIG_SNAPSHOT",
        },
        {
          "binding": "OWNER_ENFORCEMENT",
          "id": "2068e4c44e614da893a3e937342ebb94",
        },
        {
          "binding": "ASN_POLICY",
          "id": "ead91aec5ef6410d92a530974f220797",
        },
      ],
      "triggers": {
        "crons": ["*/2 * * * *"],
      },
      "queues": {
        "producers": [
          {
            "binding": "USAGE_QUEUE",
            "queue": "stella-v2-gateway-usage",
          },
        ],
        "consumers": [
          {
            "queue": "stella-v2-gateway-usage",
            "max_batch_size": 50,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "stella-v2-gateway-usage-dlq",
          },
        ],
      },
      "ratelimits": [
        {
          "name": "ANON_IP_LIMITER",
          // Must differ from development.
          "namespace_id": "41012",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
    },
  },
}
