{
  "name": "stella-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy",
    "auth:jwks": "convex run auth:getLatestJwks | convex env set JWKS",
      "generate:desktop-api": "node scripts/generate-desktop-convex-api.mjs",
    "generate:desktop-api:deployment": "convex-helpers ts-api-spec --output-file ../contracts/convex-api.ts",
    "integrations:publish-composio": "node scripts/publish-composio-native-integrations.mjs",
    "typecheck": "tsc --noEmit -p convex/tsconfig.json",
    "test": "bun test tests/",
    "test:convex": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.11",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/r2": "^0.10.2",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/resend": "^0.2.6",
    "@google/genai": "^2.6.0",
    "ajv": "^8.20.0",
    "better-call": "1.3.5",
    "better-auth": "1.6.11",
    "convex": "1.45.0",
    "jose": "^6.2.3",
    "openai": "6.39.0",
    "partial-json": "^0.1.7",
    "parse5": "^8.0.0",
    "pdf-parse": "^2.4.5",
    "stripe": "22.2.0",
    "turndown": "^7.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^25.9.1",
    "@types/turndown": "^5.0.6",
    "@typescript/native-preview": "^7.0.0-dev.20260527.2",
    "convex-helpers": "^0.1.123",
    "convex-test": "^0.0.56",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "trustedDependencies": [
    "esbuild",
    "protobufjs"
  ]
}
