# Public, non-secret build-time config baked into the renderer by Vite.
# Keep only public values in this tracked build configuration.

# Development Stella backend worker: Better Auth (/api/auth), backend calls
# (/api/rpc), live views (/owners/me/live) and conversation sockets. A public
# service location; credentials remain in the authenticated session and are
# never baked into the renderer. Release builds supply the production backend
# through connected-build environment variables instead of changing this
# tracked developer default.
VITE_STELLA_BACKEND_URL=https://stella-v2-cloud-builder-dev.lolruuxi.workers.dev

# Public Cloudflare Turnstile site key shared by web and desktop challenge UI.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAElT6LwLa_VHN9Qq

# Live public base URL for canvas shares. The renderer builds Share links and
# resolves incoming stella://.../c/<slug> deep links against this origin; the
# Cloudflare Worker at this domain serves the published HTML from R2.
VITE_CANVAS_SHARE_BASE_URL=https://stellashare.app
