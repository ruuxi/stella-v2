{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stella-v2-telemetry-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "vars": {
    "ENVIRONMENT": "development",
    // Canonical development deployment used by source builds and test traffic.
    "STELLA_CONVEX_SITE_URL": "https://outgoing-bulldog-865.convex.site",
    "ENABLE_SERVER_BEARER": "1"
  },
  "secrets": {
    "required": [
      "TELEMETRY_PSEUDONYM_KEY",
      "TELEMETRY_SERVER_SECRET",
      "CONVEX_LOG_STREAM_SECRET"
    ]
  },
  "pipelines": [
    {
      "binding": "EVENTS_PIPELINE",
      "stream": "07d5b9ff2b084f7b8ea00a4e3bbc1767"
    }
  ],
  "ratelimits": [
    {
      "name": "TELEMETRY_RATE_LIMITER",
      // Account-local integer namespace. Replace if already allocated.
      "namespace_id": "41001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "env": {
    "production": {
      "name": "stella-v2-telemetry",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        // Pinned to the packaged desktop release authority.
        "STELLA_CONVEX_SITE_URL": "https://intent-jackal-330.convex.site",
        "ENABLE_SERVER_BEARER": "1"
      },
      "secrets": {
        "required": [
          "TELEMETRY_PSEUDONYM_KEY",
          "TELEMETRY_SERVER_SECRET",
          "CONVEX_LOG_STREAM_SECRET"
        ]
      },
      "pipelines": [
        {
          "binding": "EVENTS_PIPELINE",
          "stream": "432c62bb00c7417cbc62ad5af1ecb9e8"
        }
      ],
      "ratelimits": [
        {
          "name": "TELEMETRY_RATE_LIMITER",
          // Must differ from development.
          "namespace_id": "41002",
          "simple": { "limit": 120, "period": 60 }
        }
      ]
    }
  }
}
