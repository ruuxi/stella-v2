{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stella-v2-interior-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "vars": {
    "SHARES_DISABLED": "false",
    "CONVEX_SITE_URL": "https://flexible-panther-999.convex.site",
    "CONVEX_CLOUD_URL": "https://flexible-panther-999.convex.cloud",
    "APPS_HOST_ORIGIN": "https://stella-v2-interior-dev.lolruuxi.workers.dev",
    "INTERIOR_ORIGIN": "https://stella-v2-interior-dev.lolruuxi.workers.dev",
    "EMBED_APPS_ORIGIN": "https://stella-v2-apps-host-dev.lolruuxi.workers.dev",
  },
  "r2_buckets": [
    {
      "binding": "APP_BUILDS",
      "bucket_name": "stella-v2-app-builds-dev",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "APP_ROUTES",
      "id": "dc5c7bac2bd04ec7bbd6a89f18a04ee7",
    },
  ],
}
