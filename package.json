{
  "name": "stella-v2",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/backend/workers/*",
    "workers/*"
  ],
  "main": "packages/desktop/dist-electron/electron/main.js",
  "scripts": {
    "dev": "cd packages/desktop-ui && vite",
    "preview": "cd packages/desktop-ui && vite preview",
    "build": "bun run routes:generate && node node_modules/typescript-7/bin/tsc --build packages/desktop-ui && cd packages/desktop-ui && node ../../node_modules/vite/bin/vite.js build && node ../desktop/scripts/check-renderer-bundle-budget.mjs",
    "format": "bunx prettier@3.6.2 --write .",
    "format:check": "bunx prettier@3.6.2 --check .",
    "lint": "cd packages/desktop-ui && eslint .",
    "logs": "node packages/desktop/scripts/open-logs.mjs",
    "test": "cd packages/desktop-ui && vitest",
    "test:run": "cd packages/desktop-ui && vitest run",
    "theme:test": "cd packages/theme && bun test",
    "test:electron": "cd packages/desktop-ui && vitest run --config vitest.electron.config.ts",
    "test:verification": "node --test packages/desktop/scripts/tests/*.test.mjs packages/stella-office/scripts/tests/*.test.mjs",
    "test:stella-browser": "cargo test --manifest-path packages/stella-browser/cli/Cargo.toml -- --skip test_all_documented_actions_are_handled && node --test packages/stella-browser/extension/*.test.js packages/stella-browser/extension/**/*.test.js && vitest run packages/desktop-ui/tests/runtime/kernel/browser-use/*.test.ts",
    "routes:generate": "cd packages/desktop-ui && node ../../node_modules/@tanstack/router-cli/bin/tsr.cjs generate",
    "routes:check": "node packages/desktop/scripts/check-route-tree.mjs",
    "reset": "node packages/desktop/scripts/reset-dev.mjs",
    "reset:all": "node packages/desktop/scripts/reset-dev.mjs --with-permissions",
    "reset:sql": "node packages/desktop/scripts/reset-sql.mjs",
    "native:build": "cd packages/native && bun run build",
    "native:download": "node packages/desktop/scripts/download-native-helpers.mjs",
    "stella-browser:download": "node packages/desktop/scripts/download-stella-browser.mjs",
    "stella-office:download": "node packages/stella-office/scripts/download-native.js",
    "app:create": "node packages/desktop/scripts/create-workspace-app.mjs",
    "electron:install": "bun ./node_modules/electron/install.js",
    "electron:dev": "node packages/desktop/scripts/ensure-stella-browser.mjs --allow-build-fallback --build-from-source && node packages/stella-office/scripts/ensure-native.js && node packages/desktop/scripts/dev-electron-build.mjs --once && concurrently -k \"bun run dev\" \"node packages/desktop/scripts/launch-electron-dev.mjs\"",
    "electron:typecheck:core": "node node_modules/typescript-7/bin/tsc -p packages/desktop/tsconfig.electron.json --pretty false --noEmit && node node_modules/typescript-7/bin/tsc -p packages/desktop/tsconfig.preload.json --pretty false --noEmit && bun run verify:source-exports && bun run verify:source-identifiers && bun run verify:local-named-imports",
    "electron:typecheck": "bun run electron:typecheck:core && bun run verify:ipc-handlers",
    "electron:typecheck:watch": "concurrently -k --kill-others-on-fail \"node node_modules/typescript-7/bin/tsc -w -p packages/desktop/tsconfig.electron.json --preserveWatchOutput --noEmit\" \"node node_modules/typescript-7/bin/tsc -w -p packages/desktop/tsconfig.preload.json --preserveWatchOutput --noEmit\"",
    "electron:build": "bun run native:build && bun run packaging:prepare-runtimes && bun run stella-office:download -- --force && bun run build && bun run electron:typecheck && node packages/desktop/scripts/dev-electron-build.mjs --once --verify-identifiers && electron-builder",
    "electron:pack": "bun run native:build && bun run packaging:prepare-runtimes && bun run stella-office:download -- --force && bun run build && bun run electron:typecheck && node packages/desktop/scripts/dev-electron-build.mjs --once --verify-identifiers && electron-builder --mac dir",
    "electron:release:mac": "electron-builder --mac --publish never",
    "electron:release:win": "electron-builder --win --publish never",
    "updater:verify-local": "node packages/desktop/scripts/verify-local-electron-update.mjs",
    "packaging:prepare-runtimes": "node packages/desktop/scripts/prepare-packaged-runtimes.mjs",
    "postinstall": "node packages/desktop/scripts/postinstall-workspace.mjs",
    "check:boundary": "node packages/runtime/scripts/check-boundary.mjs",
    "runtime:headless": "bun packages/runtime/headless/cli.ts",
    "verify:source-exports": "node packages/desktop/scripts/verify-source-package-exports.mjs",
    "verify:source-identifiers": "node packages/desktop/scripts/verify-packaged-identifiers.mjs --source",
    "verify:local-named-imports": "node packages/desktop/scripts/verify-local-named-imports.mjs",
    "verify:ipc-handlers": "cd packages/desktop-ui && vitest run --config vitest.electron.config.ts tests/electron/preload-handler-manifest.test.ts",
    "verify:packaged-identifiers": "node packages/desktop/scripts/verify-packaged-identifiers.mjs",
    "backend:dev": "cd packages/backend && bun run dev",
    "backend:deploy": "cd packages/backend && bun run deploy",
    "backend:typecheck": "cd packages/backend && bun run typecheck",
    "backend:test": "cd packages/backend && bun run test",
    "backend:test:convex": "cd packages/backend && bun run test:convex",
    "backend:test:lib": "cd packages/backend && bun run test:lib",
    "backend:test:all": "cd packages/backend && bun run test:all",
    "website:dev": "cd packages/website && bun run dev",
    "website:build": "cd packages/website && bun run build",
    "website:lint": "cd packages/website && bun run lint",
    "prompts:sync-defaults": "cd packages/backend && bun run prompts:sync-defaults",
    "prompts:check-defaults": "cd packages/backend && bun run prompts:check-defaults",
    "check:generated": "bun run routes:check && bun run prompts:check-defaults && node packages/backend/scripts/check-convex-api-entrypoints.mjs && node packages/backend/scripts/generate-desktop-convex-api.mjs --check && node packages/desktop/scripts/derive-ipc-payload-contract.mjs --check && node packages/mobile/scripts/sync-i18n-catalogs.mjs --check",
    "mobile:start": "cd packages/mobile && bun run start",
    "mobile:ios": "cd packages/mobile && bun run ios",
    "mobile:android": "cd packages/mobile && bun run android",
    "mobile:typecheck": "cd packages/mobile && bun run typecheck",
    "mobile:lint": "cd packages/mobile && bun run lint",
    "mobile:test": "cd packages/mobile && bun run test",
    "runtime:typecheck": "node node_modules/typescript-7/bin/tsc -p packages/runtime/tsconfig.json --pretty false --noEmit",
    "runtime:test": "cd packages/runtime && bun run test",
    "executor:typecheck": "cd packages/executor-cloud && bun run typecheck",
    "executor:test": "cd packages/executor-cloud && bun run test",
    "cloud-builder:typecheck": "cd workers/cloud-builder && bun run typecheck",
    "cloud-builder:lint:promises": "eslint --config eslint.workers.config.js workers/cloud-builder/src",
    "cloud-builder:test": "cd workers/cloud-builder && bun run test",
    "cloud-builder:build:dry-run": "cd workers/cloud-builder && bun run build:dry-run",
    "telemetry:typecheck": "cd workers/telemetry && bun run typecheck",
    "telemetry:test": "cd workers/telemetry && bun run test",
    "telemetry:build:dry-run": "cd workers/telemetry && bun run build:dry-run",
    "telemetry:validate": "python3 infra/telemetry/scripts/validate.py",
    "model-gateway:typecheck": "cd workers/model-gateway && bun run typecheck",
    "model-gateway:lint:promises": "eslint --config eslint.workers.config.js workers/model-gateway/src",
    "model-gateway:test": "cd workers/model-gateway && bun run test",
    "model-gateway:build:dry-run": "cd workers/model-gateway && bun run build:dry-run",
    "model-gateway:deploy:dev": "cd workers/model-gateway && bun run deploy:dev",
    "apps-host:typecheck": "cd workers/apps-host && bun run typecheck",
    "apps-host:lint:promises": "eslint --config eslint.workers.config.js workers/apps-host/src",
    "apps-host:test": "cd workers/apps-host && bun run test",
    "apps-host:build:dry-run": "cd workers/apps-host && bun run build:dry-run",
    "browser-gateway:typecheck": "cd workers/browser-gateway && bun run typecheck",
    "browser-gateway:lint:promises": "eslint --config eslint.workers.config.js workers/browser-gateway/src",
    "browser-gateway:test": "cd workers/browser-gateway && bun run test",
    "browser-gateway:build:dry-run": "cd workers/browser-gateway && bun run build:dry-run && bun run build:dry-run:bn118",
    "device-code-fixture:typecheck": "cd workers/device-code-fixture && bun run typecheck",
    "device-code-fixture:lint:promises": "eslint --config eslint.workers.config.js workers/device-code-fixture/src",
    "device-code-fixture:test": "cd workers/device-code-fixture && bun run test",
    "device-code-fixture:build:dry-run": "cd workers/device-code-fixture && bun run build:dry-run:bn118",
    "canvas-share:typecheck": "cd packages/backend/workers/canvas-share && bun run typecheck",
    "canvas-share:lint:promises": "eslint --config eslint.workers.config.js packages/backend/workers/canvas-share/src",
    "canvas-share:test": "cd packages/backend/workers/canvas-share && bun run test && bun run test:workerd",
    "canvas-share:build:dry-run": "cd packages/backend/workers/canvas-share && bun run build:dry-run",
    "check:ratchet": "node packages/runtime/scripts/check-effect-ratchet.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1055.0",
    "@convex-dev/better-auth": "^0.12.5",
    "@google/genai": "^2.6.0",
    "@legendapp/list": "3.0.0",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@react-three/fiber": "^9.6.1",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@sinclair/typebox": "0.34.49",
    "@smithy/node-http-handler": "^4.7.5",
    "@smithy/types": "^4.14.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.168.11",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-auth": "1.6.11",
    "cloudflared": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.44.0",
    "croner": "^10.0.1",
    "diff": "^9.0.0",
    "esbuild": "^0.28.0",
    "gaxios": "^7.1.4",
    "googleapis": "^172.0.0",
    "googleapis-common": "^8.0.1",
    "motion": "^12.40.0",
    "openai": "6.39.0",
    "partial-json": "^0.1.7",
    "picomatch": "^4.0.4",
    "proxy-agent": "^8.0.1",
    "qrcode": "^1.5.4",
    "rcedit": "^5.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-pdf": "^10.4.1",
    "recharts": "^3.8.1",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0",
    "uiohook-napi": "^1.5.5",
    "unified": "^11.0.5",
    "undici": "^8.3.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/router-cli": "1.166.40",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.1",
    "@types/picomatch": "^4.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "bun-types": "1.4.0",
    "concurrently": "^10.0.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.7",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "29.1.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.60.0",
    "vite": "8.2.1",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "axios": "^1.13.5",
    "cross-spawn": "^7.0.6",
    "node-abi": "4.33.0",
    "qs": "^6.15.0",
    "tar": "^7.5.10",
    "vite": "8.2.1"
  },
  "optionalDependencies": {
    "mac-screen-capture-permissions": "^2.1.0"
  },
  "build": {
    "appId": "com.stella.app",
    "productName": "Stella",
    "electronUpdaterCompatibility": ">=2.16",
    "afterPack": "packages/desktop/scripts/prune-packaged-install-assets.mjs",
    "afterSign": "packages/desktop/scripts/notarize.mjs",
    "extraMetadata": {
      "name": "stella-v2",
      "productName": "Stella"
    },
    "protocols": {
      "name": "Stella Auth",
      "schemes": [
        "Stella"
      ]
    },
    "directories": {
      "output": "packages/desktop/release",
      "buildResources": "packages/desktop/build",
      "app": "packages/desktop"
    },
    "files": [
      "package.json",
      "dist-electron/electron/**/*",
      "electron/recovery.html",
      {
        "from": "../desktop-ui/dist",
        "to": "renderer"
      }
    ],
    "extraResources": [
      {
        "from": "packages/desktop/build/icon.ico",
        "to": "stella-tray.ico"
      },
      {
        "from": "packages/desktop-ui/public/stella-logo.png",
        "to": "update-splash/stella-logo.png"
      },
      {
        "from": "packages/desktop-ui/src/assets/fonts/cormorant-garamond-italic.ttf",
        "to": "update-splash/cormorant-garamond-italic.ttf"
      },
      {
        "from": "packages/desktop/resources/audio",
        "to": "audio",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packages/desktop/resources/models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packages/desktop/resources/bun/current",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packages/desktop/resources/git/current",
        "to": "runtimes/git",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packages/desktop/resources/node/current",
        "to": "runtimes/node",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packages/desktop/resources/python/current",
        "to": "runtimes/python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packages/desktop/dist-electron/runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/undici",
        "to": "node_modules/undici",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/@silvia-odwyer/photon-node",
        "to": "node_modules/@silvia-odwyer/photon-node",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packages/native/out",
        "to": "native/out",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packages/home-seed",
        "to": "home-seed",
        "filter": [
          "skills/**",
          "outputs/README.md"
        ]
      },
      {
        "from": "packages/stella-browser",
        "to": "stella-browser",
        "filter": [
          "package.json",
          "bin/stella-browser.js",
          "out/**",
          "extension/**"
        ]
      },
      {
        "from": "packages/stella-office",
        "to": "stella-office",
        "filter": [
          "package.json",
          "bin/**",
          "scripts/**"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "artifactName": "Stella-${version}-Windows-${arch}.${ext}",
      "signExts": [
        "stella-browser"
      ],
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com",
        "publisherName": "FromYou, LLC",
        "sign": "packages/desktop/scripts/sign-windows.mjs"
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "packages/desktop/build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.icns",
      "hardenedRuntime": true,
      "entitlements": "packages/desktop/build/entitlements.mac.plist",
      "entitlementsInherit": "packages/desktop/build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Stella uses your microphone for voice conversations.",
        "NSScreenCaptureUsageDescription": "Stella uses screen recording when you ask it to see or capture your screen.",
        "NSAccessibilityUsageDescription": "Stella uses Accessibility when you enable global shortcuts and computer control."
      }
    },
    "dmg": {
      "artifactName": "Stella-${version}-macOS-${arch}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "artifactName": "Stella-${version}-Linux-${arch}.${ext}",
      "category": "Utility",
      "maintainer": "Stella <support@stella.app>",
      "vendor": "Stella",
      "synopsis": "Stella desktop assistant",
      "description": "Stella is a personal AI assistant that lives on your computer.",
      "mimeTypes": [
        "x-scheme-handler/stella"
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "Stella",
          "Keywords": "AI;Assistant;Agent;"
        }
      }
    },
    "pacman": {
      "artifactName": "Stella-${version}-ArchLinux-${arch}.pkg.tar.xz",
      "packageName": "stella",
      "compression": "xz",
      "depends": [
        "at-spi2-core",
        "git",
        "gnome-keyring",
        "gtk3",
        "libnotify",
        "libsecret",
        "libxss",
        "nss",
        "xdg-utils"
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://pub-a319aaada8144dc9be5a83625033769c.r2.dev/desktop-v2/stable/${os}-${arch}",
        "channel": "latest-v2",
        "useMultipleRangeRequest": false
      }
    ]
  },
  "trustedDependencies": [
    "@shopify/react-native-skia",
    "better-sqlite3",
    "bun",
    "cloudflared",
    "electron",
    "electron-winstaller",
    "esbuild",
    "mac-screen-capture-permissions",
    "msgpackr-extract",
    "protobufjs",
    "sharp",
    "sqlite3",
    "uiohook-napi"
  ],
  "patchedDependencies": {
    "@siteed/audio-studio@3.2.0": "patches/@siteed%2Faudio-studio@3.2.0.patch"
  }
}
